(fn match? [x pat]
  "Does `x` match pattern `pat`"
  `(case ,x (where ,pat) true _# false))

(fn nil? [x] `(= nil ,x))

(fn assert-match [pattern value ?msg]
  `(case ,value
     ,pattern ,value
     _# (error ,(or ?msg (.. (view value) " must match " (view pattern))))))

